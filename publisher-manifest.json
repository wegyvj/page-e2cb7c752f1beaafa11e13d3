x}\n.price{font-size:34px;font-weight:800;color:var(--violet-deep);white-space:nowrap}\n.price span{font-size:14px;font-weight:600;color:var(--muted)}\n.annual{font-size:13px;color:var(--muted);margin-top:2px;text-align:right}\n.feat{list-style:none;margin-top:20px;display:grid;gap:10px}\n.feat li{position:relative;padding-left:26px;font-size:15px}\n.feat li::before{content:\"\";position:absolute;left:0;top:8px;width:12px;height:12px;background:var(--violet)}\n.plan-note{margin-top:18px;font-size:13px;color:var(--muted);border-top:2px dashed #c3c6d1;padding-top:12px}\n\n/* ---------- clients 编号大字压底 ---------- */\n.clients{display:grid;gap:22px;margin-top:30px}\n@media(min-width:720px){.clients{grid-template-columns:1fr 1fr}}\n.client{background:var(--paper);border:3px solid var(--line);padding:24px 24px 60px;position:relative;overflow:hidden}\n.client .num{position:absolute;right:14px;bottom:-14px;font-size:96px;font-weight:800;color:var(--violet-soft);line-height:1;z-index:0}\n.client>*{position:relative;z-index:1}\n.client h3{color:var(--violet-deep)}\n.client ul{list-style:none;margin-top:12px;display:grid;gap:8px;font-size:14px;color:var(--muted)}\n.client ul li{padding-left:18px;position:relative}\n.client ul li::before{content:\"›\";position:absolute;left:0;color:var(--violet);font-weight:800}\n.client .get{margin-top:16px;font-size:13px;color:var(--muted)}\n.client .get b{color:var(--ink)}\n\n/* ---------- faq details ---------- */\n.faq{margin-top:30px;display:flex;flex-direction:column;gap:14px}\ndetails{background:var(--paper);border:3px solid var(--line)}\nsummary{cursor:pointer;list-style:none;padding:18px 22px;font-weight:800;font-size:16px;display:flex;justify-content:space-between;align-items:center;gap:16px}\nsummary::-webkit-details-marker{display:none}\nsummary::after{content:\"+\";font-size:24px;color:var(--violet);line-height:1}\ndetails[open] summary::after{content:\"–\"}\ndetails p{padding:0 22px 20px;color:var(--muted);font-size:15px}\ndetails[open]{border-color:var(--violet)}\n\n/* ---------- closing band ---------- */\n.band{margin-top:78px;background:var(--violet);color:#fff;padding:34px 28px;border:3px solid var(--line)}\n.band h2{color:#fff}\n.band p{color:#f0e6ff;margin-top:10px;max-width:56ch}\n.band a{display:inline-block;margin-top:18px;background:#fff;color:var(--violet-deep);font-weight:800;padding:11px 22px;border:3px solid var(--line)}\n\nfooter{margin-top:60px;padding-top:24px;border-top:3px solid var(--line);font-size:13px;color:var(--muted)}\n</style><div class=\"wrap shell\">\n\n  \n  <aside class=\"sidenav\" aria-label=\"页面导航\">\n    <div class=\"brandmark\"><span class=\"dot\"></span>小川</div>\n    <ul class=\"navlist\">\n      <li><a href=\"#start\"><span class=\"idx\">01</span>从哪里开始</a></li>\n      <li><a href=\"#plans\"><span class=\"idx\">02</span>套餐怎么选</a></li>\n      <li><a href=\"#use\"><span class=\"idx\">03</span>上手三步</a></li>\n      <li><a href=\"#clients\"><span class=\"idx\">04</span>在哪些设备上用</a></li>\n      <li><a href=\"#faq\"><span class=\"idx\">05</span>常见疑问</a></li>\n    </ul>\n  </aside>\n\n  <main>\n\n    \n    <section class=\"hero\" id=\"start\">\n      <span class=\"kicker\">小川 · 网络服务</span>\n      <h1>xiaochuan · 把上网这件小事，<br>走成一条<em>顺溜的路</em>。</h1>\n      <p class=\"lead\">我们不太爱喊口号，也不太喜欢堆数字。小川想做的，是当你打开网页、连上会议、追完一集剧的时候，感觉不到“卡”这个字存在。下面这条线，是从你第一次听说小川，到真正用起来的过程。</p>\n\n      <div class=\"tl\">\n        <div class=\"tl-item active\">\n          <span class=\"tl-node\"></span>\n          <div class=\"tl-step\">第一步 · 认识</div>\n          <div class=\"tl-title\">先搞懂你要的是什么</div>\n          <div class=\"tl-body\">有人只是想让视频别转圈，有人要同时挂好几台设备，还有人希望游戏延迟低一点。想清楚场景，比急着选套餐更重要。</div>\n        </div>\n        <div class=\"tl-item\">\n          <span class=\"tl-node\"></span>\n          <div class=\"tl-step\">第二步 · 挑选</div>\n          <div class=\"tl-title\">按流量和设备数对号入座</div>\n          <div class=\"tl-body\">小川把选择简化成三档节奏——够用、宽裕、给团队。每一档都写清了每月流量、可同时在线的设备数量，以及它擅长的用途。</div>\n        </div>\n        <div class=\"tl-item\">\n          <span class=\"tl-node\"></span>\n          <div class=\"tl-step\">第三步 · 连接</div>\n          <div class=\"tl-title\">装好工具，登录即用</div>\n          <div class=\"tl-body\">在你常用的系统里装上对应客户端，用账号登录，线路会自动匹配。没有复杂的配置文件要你手动填。</div>\n        </div>\n        <div class=\"tl-item\">\n          <span class=\"tl-node\"></span>\n          <div class=\"tl-step\">第四步 · 稳定</div>\n          <div class=\"tl-title\">用得久了，才知道差别</div>\n          <div class=\"tl-body\">真正的体验不在第一天，而在连续几周的日常里。遇到不顺的地方，随时能找到人问——这也是套餐里包含的支持。</div>\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"plans\">\n      <span class=\"kicker\">套餐</span>\n      <h2>三档节奏，随你的用量来定</h2>\n      <p class=\"lead\">价格都是明码标价，按月或按年付都行。下面的权益直接列全，不玩“详见官网”那一套。</p>\n\n      <div class=\"plans\">\n        <article class=\"plan\">\n          <div class=\"plan-head\">\n            <div>\n              <div class=\"plan-name\">基础版</div>\n              <div class=\"plan-tag\">一个人日常刷剧、查资料刚好够</div>\n            </div>\n            <div>\n              <div class=\"price\">¥15<span>/月</span></div>\n              <div class=\"annual\">按年付仅需 ¥150/年</div>\n            </div>\n          </div>\n          <ul class=\"feat\">\n            <li>每月 100GB 极速流量</li>\n            <li>支持 3 台设备同时在线</li>\n            <li>解锁基础流媒体</li>\n            <li>普通线路节点池</li>\n          </ul>\n          <p class=\"plan-note\">适合刚开始尝试、用量还不算大的朋友。先用起来，觉得不够再升级也不迟。</p>\n        </article>\n\n        <article class=\"plan featured\">\n          <span class=\"ribbon\">多数人选这档</span>\n          <div class=\"plan-head\">\n            <div>\n              <div class=\"plan-name\">旗舰版</div>\n              <div class=\"plan-tag\">家庭多设备 + 游戏党比较合适</div>\n            </div>\n            <div>\n              <div class=\"price\">¥35<span>/月</span></div>\n              <div class=\"annual\">按年付仅需 ¥350/年</div>\n            </div>\n          </div>\n          <ul class=\"feat\">\n            <li>每月 300GB 极速流量</li>\n            <li>支持 5 台设备同时在线</li>\n            <li>全节点原生流媒体解锁</li>\n            <li>IPLC 专线游戏加速优化</li>\n            <li>7×24 优先工单支持</li>\n          </ul>\n          <p class=\"plan-note\">这一档把“看得全”和“打得稳”都照顾到了，还给了全天候的优先响应，是我们最常被推荐的选择。</p>\n        </article>\n\n        <article class=\"plan\">\n          <div class=\"plan-head\">\n            <div>\n              <div class=\"plan-name\">团队版</div>\n              <div class=\"plan-tag\">小组协作、多人共用一套额度</div>\n            </div>\n            <div>\n              <div class=\"price\">¥85<span>/月</span></div>\n              <div class=\"annual\">按年付仅需 ¥850/年</div>\n            </div>\n          </div>\n          <ul class=\"feat\">\n            <li>每月 1000GB 极速流量</li>\n            <li>支持 20 台设备同时在线</li>\n            <li>VIP 专属高带宽节点</li>\n            <li>支持企业定制路由</li>\n            <li>专属客户经理服务</li>\n          </ul>\n          <p class=\"plan-note\">当人数上来、需求变得个性化时，这一档提供独立的高带宽通道和专人对接，省得自己摸索配置。</p>\n        </article>\n      </div>\n    </section>\n\n    \n    <section id=\"use\">\n      <span class=\"kicker\">怎么用起来</span>\n      <h2>上手其实就三步</h2>\n      <div class=\"grid2\">\n        <div class=\"card\">\n          <h3>① 选档并开通</h3>\n          <p>对照上面的权益挑一档，确认按月还是按年。开通后账号即刻生效，不需要额外审核等待。</p>\n        </div>\n        <div class=\"card\">\n          <h3>② 装客户端登录</h3>\n          <p>在下方“在哪些设备上用”找到对应系统的版本，安装后用账号登录，线路会自动为你匹配。</p>\n        </div>\n        <div class=\"card\">\n          <h3>③ 日常按需切换</h3>\n          <p>需要看不同平台内容、或打游戏想要更低的往返延迟时，可在客户端内切换对应线路即可。</p>\n        </div>\n        <div class=\"card\">\n          <h3>④ 有问题就找工单</h3>\n          <p>旗舰版及以上享有优先工单，描述清楚现象（哪个应用、什么时间段）能更快被定位处理。</p>\n        </div>\n      </div>\n    </section>\n\n    \n    <section id=\"clients\">\n      <span class=\"kicker\">客户端</span>\n      <h2>在你手边的设备上都能用</h2>\n      <p class=\"lead\">下面是各端的使用说明与获取方式。为避免给你错误的下载地址，此处只提供中性指引，请以官方渠道发布的最新版本为准。</p>\n\n      <div class=\"clients\">\n        <article class=\"client\">\n          <span class=\"num\">01</span>\n          <h3>桌面端 · Windows / macOS</h3>\n          <ul>\n            <li>安装后常驻后台，一键开关</li>\n            <li>支持开机自动启动</li>\n            <li>可记忆上次使用的线路偏好</li>\n          </ul>\n          <p class=\"get\"><b>获取：</b>请在官方发布页选择与你系统对应的安装包，核对版本号后再下载。</p>\n        </article>\n\n        <article class=\"client\">\n          <span class=\"num\">02</span>\n          <h3>移动端 · iOS / Android</h3>\n          <ul>\n            <li>界面精简，主要操作都在首页</li>\n            <li>支持流量用量查看</li>\n            <li>可同时登录多台手机与平板</li>\n          </ul>\n          <p class=\"get\"><b>获取：</b>请通过官方渠道提供的分发入口安装，避免使用来源不明的第三方包。</p>\n        </article>\n\n        <article class=\"client\">\n          <span class=\"num\">03</span>\n          <h3>路由器 / 全屋共享</h3>\n          <ul>\n            <li>适合团队版做多设备统一接入</li>\n            <li>减少逐台安装的重复工作</li>\n            <li>可按设备做简单的分流规则</li>\n          </ul>\n          <p class=\"get\"><b>获取：</b>此类部署涉及具体型号差异，建议联系客户经理或提交工单获取适配说明。</p>\n        </article>\n\n        <article class=\"client\">\n          <span class=\"num\">04</span>\n          <h3>通用注意事项</h3>\n          <ul>\n            <li>同一账号受套餐设备数上限约束</li>\n            <li>超出上限时新设备需先下线旧设备</li>\n            <li>保持客户端为较新版本以获得线路更新</li>\n          </ul>\n          <p class=\"get\"><b>提示：</b>若某端暂无对应版本，可通过其他已支持设备完成相同用途。</p>\n        </article>\n      </div>\n    </section>\n\n    \n    <section id=\"faq\">\n      <span class=\"kicker\">常见疑问</span>\n      <h2>你可能想先问清楚的几件事</h2>\n\n      <div class=\"faq\">\n        <details>\n          <summary>我该怎么判断自己该选哪一档？</summary>\n          <p>先看两个数就够了：一是大概会用几台设备同时在线，二是每月流量消耗的量级。一个人偶尔刷刷，基础版的 100GB 与 3 台设备通常够用；家里人多、还想兼顾游戏，旗舰版更稳妥；多人共用、或有定制需求，就直接上团队版。</p>\n        </details>\n\n        <details>\n          <summary>按年付和按月付有什么区别？</summary>\n          <p>权益完全一致，区别只在付费周期与总价。以旗舰版为例，按月是 ¥35/月，按年为 ¥350/年，相当于少付一个月的费用。如果你打算长期用，按年更划算；还在观望阶段，可以先按月试。</p>\n        </details>\n\n        <details>\n          <summary>可以同时用几台设备？超了会怎样？</summary>\n          <p>每档都有明确的同在线上限：基础版 3 台、旗舰版 5 台、团队版 20 台。当已达上限时，新加入的设备需要先让一台现有设备下线，才能正常接入，不会无故挤掉正在使用的设备。</p>\n        </details>\n\n        <details>\n          <summary>“流媒体解锁”到底指什么？</summary>\n          <p>指的是让部分平台的播放区域限制对你不再那么明显，从而能访问对应地区的内容库。基础版覆盖常见的入门平台，旗舰版则面向全部节点的原生解锁能力。能否成功取决于平台本身策略，这一点我们无法替你保证每一次都通。</p>\n        </details>\n\n        <details>\n          <summary>出问题找不到原因怎么办？</summary>\n          <p>先在客户端记录一下现象：是哪个应用、发生在什么时间段、当时用的是哪条线路。带着这些信息提交工单，会比一句“连不上”更容易被快速定位。旗舰版及以上还有优先响应通道。</p>\n        </details>\n\n        <details>\n          <summary>以后可以换档或取消吗？</summary>\n          <p>套餐之间可以按需调整，比如从基础升到旗舰。具体生效时间与差额处理方式，建议在你决定变更前向客服确认一次，以免误解计费周期。</p>\n        </details>\n      </div>\n    </section>\n\n    \n    <section class=\"band\" id=\"contact\">\n      <h2>还没想好？先把问题说出来。</h2>\n      <p>不确定哪一档合适、或者某个平台总是打不开，都可以直接来找我们聊。说清你的用法，我们再一起看怎么配最省事。</p>\n      <a href=\"#faq\">回到常见疑问看看 →</a>\n    </section>\n\n    <footer>\n      本页信息以小川当前公开的套餐与使用说明为准。文中未标注的地址一律留空，请以官方渠道发布的最新内容为准。\n    </footer>\n\n  </main>\n</div>",
