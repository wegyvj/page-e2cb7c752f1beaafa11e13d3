          "body": "<style>\n:root{--bg:#e9eaef;--paper:#f5f6f9;--ink:#20222b;--muted:#6b6e7c;--line:#2a2d38;--violet:#7b2ff7;--violet-deep:#4b1fa3;--violet-soft:#efe6ff}\n*{box-sizing:border-box;margin:0;padding:0}\nhtml{}\nbody{font-family:\"PingFang SC\",\"Hiragino Sans GB\",\"Microsoft YaHei\",-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;background:var(--bg);color:var(--ink);line-height:1.75;-webkit-font-smoothing:antialiased}\na{color:inherit;text-decoration:none}\n\n/* ---------- layout ---------- */\n.wrap{max-width:1180px;margin:0 auto;padding:0 22px}\n.shell{display:block}\n@media(min-width:960px){\n  .shell{display:grid;grid-template-columns:230px 1fr;gap:48px;align-items:start}\n}\n\n/* ---------- side nav ---------- */\n.sidenav{position:sticky;top:0;padding:26px 0}\n@media(max-width:959px){\n  .sidenav{position:static;border-bottom:3px solid var(--line)}\n}\n.brandmark{font-size:26px;font-weight:800;letter-spacing:.02em;display:flex;align-items:center;gap:10px;margin-bottom:22px}\n.brandmark .dot{width:14px;height:14px;background:var(--violet);border:3px solid var(--line)}\n.navlist{list-style:none;display:flex;flex-direction:column;gap:2px}\n.navlist a{display:flex;align-items:center;gap:12px;padding:9px 12px;font-size:14px;color:var(--muted);border-left:3px solid transparent;transition:.18s}\n.navlist a:hover,.navlist a:focus{color:var(--ink);background:var(--violet-soft);border-left-color:var(--violet)}\n.navlist .idx{font-weight:800;color:var(--violet);font-size:12px;width:20px}\n\n/* ---------- main ---------- */\nmain{padding:34px 0 90px;min-width:0}\nsection{margin-top:78px}\nsection:first-child{margin-top:0}\n.kicker{display:inline-block;font-size:12px;font-weight:800;letter-spacing:.18em;text-transform:uppercase;color:var(--violet-deep);border:2px solid var(--line);padding:4px 12px;margin-bottom:18px}\nh2{font-size:clamp(26px,4vw,38px);font-weight:800;line-height:1.2;letter-spacing:-.01em}\nh3{font-size:19px;font-weight:800;margin-bo